59B61C7B5A2F9C69000009D479611D26,0,"{0?TOUR RESTANT,TOURS RESTANTS}"
59B61C7B5A2FAC8100000AE17BC3E789,0,TEMPS ÉCOULÉ !
59B61C7B5A2FADE000000AE8334A9C6F,0,Passer au tour de l'adversaire ?
59B61C7B5A2FAEFF00000AF27A67A28A,0,CHANGER LA CARTE OU LES ÉQUIPES
59B61C7B5A2FB3D200000B61B8E1D855,0,CARTE ALÉATOIRE
